{
  "name": "JFrog AI Catalog Workshop",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.20.0"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "JFROG_URL": "https://alexwangtrial.jfrog.io",
    "JFROG_SERVER_ID": "workshop",
    "JF_PROJECT": "workshop",
    "HF_ENDPOINT": "https://alexwangtrial.jfrog.io/artifactory/api/huggingfaceml/workshop-huggingfaceml"
  },
  "secrets": {
    "JFROG_ACCESS_TOKEN": {
      "description": "講師核發、限 Project workshop 且具最小權限的短期 Access Token。請勿貼到 Copilot Chat、終端輸出或 Git。",
      "documentationUrl": "https://docs.github.com/en/codespaces/managing-your-codespaces/managing-your-account-specific-secrets-for-github-codespaces"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot"
      ],
      "settings": {
        "chat.plugins.marketplaces": [
          "https://github.com/jfrog/vscode-plugin/"
        ],
        "chat.promptFilesRecommendations": {
          "module1": true,
          "module2": true,
          "module3": true,
          "module4": true
        }
      }
    }
  }
}
