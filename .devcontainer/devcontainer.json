{
  "name": "JFrog Workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "remoteEnv": {
    "JFROG_PLATFORM_URL": "$JFROG_PLATFORM_URL",
    "JFROG_SERVER_ID": "workshop",
    "JF_PROJECT": "$JF_PROJECT"
  },
  "secrets": {
    "JFROG_ACCESS_TOKEN": {
      "description": "JFrog Access Token。仅由 Codespaces 注入，不要写入仓库。"
    },
    "JFROG_PLATFORM_URL": {
      "description": "JFrog Platform 主机名，不包含 https:// 或路径，例如 acme.jfrog.io。"
    },
    "JF_PROJECT": {
      "description": "JFrog Project Key，用于 Agent Guard 和 npm Virtual Repository。"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "chat.plugins.enabled": true,
        "chat.useHooks": true,
        "chat.plugins.marketplaces": [
          "https://github.com/jfrog/vscode-plugin/"
        ]
      }
    },
    "codespaces": {
      "openFiles": [
        "modules/01/README.md"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-jfrog-plugin.sh",
  "postStartCommand": "bash .devcontainer/setup-jfrog-plugin.sh --plugin-only"
}
